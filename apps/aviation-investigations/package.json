{
  "name": "aviation-casebook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run --project unit --project web",
    "test:web": "vitest run --project web",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "services:up": "tsx scripts/services.ts up",
    "services:down": "tsx scripts/services.ts down",
    "services:setup": "tsx scripts/services-setup.ts",
    "worker": "tsx worker/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "build": "vite build && tsc -p tsconfig.server.json",
    "extract:image": "docker build -t aviation-extract:mdbtools-1.0.0 docker/extract",
    "fixtures:build": "tsx scripts/build-fixtures.ts",
    "fixtures:build-ui": "tsx scripts/build-ui-fixtures.ts",
    "mock:build": "tsx scripts/build-mock-api.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@elastic/elasticsearch": "^9.5.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.104.5",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "drizzle-orm": "0.45.4",
    "entities": "8.1.0",
    "htmlparser2": "12.0.0",
    "lucide-react": "^1.60.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "tailwindcss": "^4.3.3",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yazl": "^3.3.1"
  }
}
