{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // oxlint's default plugins and React. The React plugin is set here, not in the override below,
  // because an override cannot set categories; its rules find nothing outside the React client.
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  // The tool's default rule set: the correctness rules of these plugins, here as errors.
  "categories": { "correctness": "error" },
  "rules": {
    // Switched off: the app strips ASCII control characters from untrusted text on purpose, in
    // shared/, server/, scripts/ and tests/, so every finding of this rule is such a deliberate
    // match. Listed as a follow-up to switch it back on with per-line reasons.
    "no-control-regex": "off"
  },
  "overrides": [
    {
      // The React client and its component tests.
      "files": ["web/**", "tests/web/**"],
      "rules": {
        // oxlint files rules-of-hooks under pedantic, not correctness, so it is switched on here,
        // where React hooks are written; elsewhere a function named use... is not a hook.
        "react/rules-of-hooks": "error",
        // Switched off: a React Compiler rule. TurnstileGate and CaseDrawer read and write refs
        // during render on purpose (the latest props, the element that opened the drawer), and
        // moving that out of render changes when focus and widget state update. A follow-up.
        "react/refs": "off",
        // Switched off: a React Compiler rule. Explore, SignInDialog and ImportStatus reset state
        // in effects when a prop changes; deriving it instead is a refactor that changes render
        // timing. A follow-up.
        "react/set-state-in-effect": "off"
      }
    }
  ],
  "ignorePatterns": [
    // Build output of `pnpm build` (vite and tsc).
    "dist/**",
    // Playwright's test output and HTML report.
    "test-results/**",
    "playwright-report/**",
    // Public sample data generated by `pnpm fixtures:build` and `pnpm fixtures:build-ui`.
    "fixtures/**",
    // Fixture data of the tests, such as an earlier version of a module kept as text.
    "tests/fixtures/**"
  ]
}
