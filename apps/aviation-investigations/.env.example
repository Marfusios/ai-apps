# Configuration contract of the API server, the worker and the scripts (README "Setup").
# Variables are listed with empty or default values; APP_URL and ELASTICSEARCH_URL must be http(s) URLs.
# Existing nonempty process values take priority over local dotenv values.
# Comma-separated dotenv files (absolute or app-relative), highest priority first.
# Process env wins over files; only variables listed here are loaded from them.
AVIATION_ENV_FILES=
NODE_ENV=development
# Deployment environment, dev or live: Compose project ai-aviation-<APP_ENV>
# (docs/RUNBOOK.md), database aviation_<env>, index prefix ai-aviation-<env>.
APP_ENV=dev
# Schedule intent for admin status; does not install/start a timer (docs/IMPORTER.md).
AVIATION_IMPORTS_ENABLED=false
APP_URL=http://localhost:3000
# Listen address of the API server: loopback by default; the container uses 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# Comma-separated CIDRs whose peers are trusted proxies (CF-Connecting-IP). Empty: no
# proxy is trusted. Set (tunnel mode): requests from any other peer are rejected.
# Compose sets it from EDGE_SUBNET in tunnel mode.
TRUSTED_PROXY_CIDRS=
# Web dev server (pnpm dev:web) and the API it proxies /api to. Never sent to the browser.
WEB_DEV_PORT=5173
WEB_DEV_API_URL=http://localhost:3000
# 1 = answer /api in the dev server's browser from the fixture mocks (web/mock), no API needed.
WEB_MOCK_API=
# In that mode, the scale of an AI search's simulated stage times: 1 (default) as long as live, 0 at once.
WEB_MOCK_EVIDENCE_TIMING=
# Port of the mock-mode dev server that pnpm test:e2e starts (default 5180).
E2E_PORT=
# Port of the real API server that pnpm test:e2e:real starts (default 5181).
E2E_REAL_PORT=
# Logins aviation_<env>_{app,migrator,ingest} on database aviation_<env>; each URL ends
# in ?options=-c%20role%3D<group role> (aviation_app, aviation_migrator, aviation_ingest).
# Written by pnpm services:setup (local) or scripts/provision-shared.ts (shared servers).
# In a Compose env file these are addresses on the shared networks below.
DATABASE_URL=
DATABASE_MIGRATOR_URL=
DATABASE_INGEST_URL=
# Generated into .env.local by pnpm services:up / services:setup (local services only).
ELASTIC_PASSWORD=
POSTGRES_PASSWORD=
# Local `test` environment for the integration tests (database aviation_test, indices
# aviation-test-*), written by pnpm services:setup.
TEST_DATABASE_URL=
TEST_DATABASE_MIGRATOR_URL=
TEST_DATABASE_INGEST_URL=
TEST_ELASTICSEARCH_READ_API_KEY=
TEST_ELASTICSEARCH_WRITE_API_KEY=
# Local service ports for compose.local-services.yaml (development only).
POSTGRES_PORT=55432
ELASTICSEARCH_PORT=59200
# The local profile serves plain HTTP on loopback; set a CA file for TLS deployments.
ELASTICSEARCH_URL=http://localhost:59200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_READ_API_KEY=
ELASTICSEARCH_WRITE_API_KEY=
# Host path; Compose mounts it read-only into the app and ingest containers.
ELASTICSEARCH_CA_FILE=
# ai-aviation-<env>: the shared cluster's ai-* index template applies to these indices.
ELASTICSEARCH_INDEX_PREFIX=ai-aviation-dev

# Language-model provider, chosen by operators at deployment; never user-visible.
# Only the Anthropic adapter exists initially (docs/DESIGN.md section 9).
AI_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_SCOPE_MODEL=claude-haiku-5-5
ANTHROPIC_ANSWER_MODEL=claude-opus-5-5
ANTHROPIC_CHECK_MODEL=claude-haiku-5-5

# Embeddings always use OpenAI; changing them requires a full reindex.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Generated summaries stay disabled while evidence search uses the provider keys.
AI_BRIEFS_ENABLED=false
# Claim-level display of AI briefs: show what the evidence check confirmed and remove the
# rest (docs/DESIGN.md §5). Keep false until the gate review clears it: with false, a
# summary is shown only when every claim was confirmed.
AI_PARTIAL_DISPLAY=false
# Used only when AI_LLM_PROVIDER=openai, after that adapter exists.
OPENAI_SCOPE_MODEL=gpt-5.6-luna
OPENAI_ANSWER_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_CHECK_MODEL=gpt-5.6-luna

# Frozen retrieval configuration of AI briefs (docs/RUNBOOK.md, "Retrieval version"):
# retrieval.v2 when empty (case-level fusion with the cases-index channel), retrieval.v1
# (the rollback: passage channels only) or retrieval.v2-nf (experimental, dev only).
AVIATION_RETRIEVAL_VERSION=

# Evidence search only (independent of AI briefs' retrieval setting).
# Empty/default: er-q-v1 (question, no rerank); the ONLY configuration allowed on live.
# Dev grid: er-{q,t,qt}-v1, er-{q,t,qt}-h50-v1, er-{q,t,qt}-h100-v1;
# er-{t,qt}-s50-v1 uses Sonnet for evaluation. See RUNBOOK "Evidence ranking".
AVIATION_EVIDENCE_RANKING=
# Independent automatic-state policy: none (default/rollback), state-explicit.v1.3.
# Both are allowed on dev and live; enabling state does not change the ranking allowlist.
AVIATION_EVIDENCE_AUTO_FILTERS=

# Optional server-side tracing; see docs/OBSERVABILITY_AND_EVALUATION.md.
# The AVIATION_ switch is application-owned. No tracing/export when disabled.
# When enabled, require an explicit endpoint and project keys; no cloud fallback.
AVIATION_TRACING_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL must be https (or loopback). A plain-http address on a private
# container network is accepted only for a host listed here (comma-separated host names);
# otherwise the server logs "tracing off" with the reason and exports nothing.
AVIATION_TRACING_HTTP_HOSTS=

# Google sign-in (Better Auth; README "Google sign-in and accounts"). Without the client ID
# and secret sign-in is off (googleEnabled: false, /api/auth answers 404). The OAuth client
# is a Google "Web application" whose authorized redirect URI is
# <APP_URL>/api/auth/callback/google. BETTER_AUTH_SECRET signs the session cookie and seals
# the OAuth state: at least 32 random characters (pnpm services:setup generates one);
# changing it signs everyone out.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile: every anonymous AI request needs a check. Without both keys
# anonymous AI stays off. For local development pnpm services:setup writes Cloudflare's
# public test keys (site 1x00000000000000000000AA, secret
# 1x0000000000000000000000000000000AA: every check passes); APP_ENV=live refuses them.
TURNSTILE_SECRET_KEY=
# Public site key, served to the browser at runtime through GET /api/config.
TURNSTILE_SITE_KEY=
# HMAC keys for stored identities, at least 32 characters each; AI stays off without them.
# IP_HMAC_SECRET: network identities. IDENTITY_HMAC_SECRET: trial ids and Google issuer/sub,
# and (through derived keys) the trial cookie's signature and stored hash.
IP_HMAC_SECRET=
IDENTITY_HMAC_SECRET=

# Proposed beta ceilings, enforced across requests and workers.
# Raised to $100 while the Anthropic launch credit lasts; revisit afterwards.
AI_MONTHLY_BUDGET_USD=100
AI_INTERACTIVE_MONTHLY_BUDGET_USD=80
# Each AI brief holds its worst case ($0.31 with the Opus answer model; DESIGN §9) until it
# settles at its actual cost (about $0.11 typical): $3 holds nine reservations at once (budget
# capacity; the concurrency limits below apply separately) and admits about 22–25 briefs a day
# (DESIGN §9, Budget).
AI_INTERACTIVE_DAILY_BUDGET_USD=3
# Shared by indexing, experiments, and background model-judge evaluations.
AI_INGESTION_MONTHLY_BUDGET_USD=20
# Despite the legacy name, this is per UTC day; the cookie lasts 30 days.
AI_ANONYMOUS_TRIAL_REQUESTS=10
# Fraction of the paced daily interactive allowance available to anonymous trials.
AI_ANONYMOUS_BUDGET_SHARE=0.25
AI_NEW_ACCOUNT_DAILY_REQUESTS=20
AI_NEW_ACCOUNT_DAYS=3
AI_USER_DAILY_REQUESTS=50
AI_USER_MONTHLY_REQUESTS=600
AI_GLOBAL_CONCURRENCY=2

# Enterprise API contract/access still needs verification.
NTSB_API_KEY=

# Worker verification reports (absolute or app-relative); default data/work.
AVIATION_VERIFY_DIR=

# Docker Compose deployment (compose.yaml, docs/RUNBOOK.md). Interpolation only:
# each container receives just the variables compose.yaml lists for it.
# Application image tag; live requires an explicit release tag (not dev).
APP_VERSION=
# Explicit dev canary: use an existing, git-tagged release image by ID, never build/pull.
# Requires APP_VERSION; no tunnel or tracing. Ordinary dev builds refuse existing Git tags.
AVIATION_DEV_RELEASE_IMAGE=false
# Names of the shared stacks' Docker networks (machine-specific).
SHARED_POSTGRES_NETWORK=
SHARED_ELASTICSEARCH_NETWORK=
# Only with tracing (compose.tracing.yaml).
SHARED_OBSERVABILITY_NETWORK=
# Cloudflare Tunnel connector token. live always runs tunnel mode and needs it; on dev,
# setting it switches pnpm app:up to tunnel mode (no app port).
TUNNEL_TOKEN=
# Subnet of the edge network in tunnel mode: an unused private (RFC 1918) /28,
# distinct per environment. The app trusts proxy headers only from it.
EDGE_SUBNET=
# Host data directory mounted read-only into ingest (default ./data).
AVIATION_DATA_DIR=
# Private directory outside the repository for pnpm app:backup and pnpm app:restore.
AVIATION_BACKUP_DIR=
# Optional wrapper lock; mandatory with the importer for ALL backup/restore invocations.
# Absolute existing regular file, owned by the invoking user, mode 0600, no symlink.
# Parent: owned by that user, no group/other write bit, not a symlink; outside importer root.
# Use the exact same file as the importer's maintenanceLock (RUNBOOK, "Maintenance lock").
AVIATION_MAINTENANCE_LOCK=
# Bounded flock wait, whole seconds 0-86400; 0 is nonqueuing. Timeout exits 75.
AVIATION_MAINTENANCE_LOCK_WAIT_SECONDS=1500
# Host user the ingest and backup containers run as; the wrappers set them to the current user.
AVIATION_UID=
AVIATION_GID=

# Admin overview: verified Google emails, comma-separated; empty means no administrators.
AIRCASE_ADMIN_EMAILS=
