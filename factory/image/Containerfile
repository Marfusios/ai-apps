ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 python3-venv python3-pip ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
ARG CLAUDE_CODE_VERSION
RUN npm install -g --no-fund --no-audit @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
 && corepack enable
COPY harness /opt/factory/harness
COPY managed-settings.json /etc/claude-code/managed-settings.json
RUN chmod -R a+rX,a-w /opt/factory/harness /etc/claude-code
# The agent's global npm installs go to its home and come last on PATH, so none shadows a system command.
ARG AGENT_HOME=/home/node
ENV NPM_CONFIG_PREFIX=${AGENT_HOME}/.npm-global
ENV PATH=${PATH}:${AGENT_HOME}/.npm-global/bin
# tini is process 1, so the CLI is not, and the processes its tools leave behind are reaped.
ENTRYPOINT ["/usr/bin/tini", "--"]
USER node
WORKDIR /workspace
