# Settings of the factory's dispatcher (python3 -m factory.dispatcher).
# Copy to ~/.config/factory/dispatcher.env of the dispatcher's user and replace every <...>.
# systemd and the shell both read this file: keep each value plain, with no quotes or spaces,
# and comments on lines of their own. docs/factory/HOST_SETUP.md explains each value.

# The repository the factory works on, as owner/name.
FACTORY_REPOSITORY=<owner>/<repository>

# The GitHub App: its App ID and the id of its installation on the repository.
FACTORY_APP_ID=<app-id>
FACTORY_INSTALLATION_ID=<installation-id>

# The absolute path of the App's private key, readable by the dispatcher's user only,
# for example <dispatcher-home>/.config/factory/app.pem.
FACTORY_APP_KEY_FILE=

# The App's bot account: its login and its numeric user id, which is not the App ID.
FACTORY_BOT_LOGIN=<app-slug>[bot]
FACTORY_BOT_USER_ID=<bot-user-id>

# The spool shared with the runner, and the mirror of the repository the runner clones from.
FACTORY_SPOOL_DIR=/srv/factory/spool
FACTORY_MIRROR_DIR=/srv/factory/mirror

# The dispatcher's own state: the repository it checks bundles in, and scratch files.
FACTORY_STATE_DIR=<dispatcher-home>/.local/state/factory
