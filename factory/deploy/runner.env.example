# Settings of the factory's runner (python3 -m factory.runner) and of python3 -m factory.image.build.
# Copy to ~/.config/factory/runner.env of the runner's user and replace every <...>.
# systemd and the shell both read this file: keep each value plain, with no quotes or spaces,
# and comments on lines of their own. docs/factory/HOST_SETUP.md explains each value.

# The spool shared with the dispatcher, and the dispatcher's mirror of the repository.
FACTORY_SPOOL_DIR=/srv/factory/spool
FACTORY_MIRROR_DIR=/srv/factory/mirror

# The runner's own directory: its lock, the job workspaces and the transcripts.
# Podman reads a colon or a comma in a mount as a separator, so no directory may contain one.
FACTORY_WORK_DIR=<runner-home>/.local/state/factory

# The agent image, built by python3 -m factory.image.build under this name.
FACTORY_IMAGE=localhost/factory-agent

# CLAUDE_CODE_OAUTH_TOKEN is not set here. It lives in ~/.config/factory/claude.env, a file of its
# own that only the runner's user can read.
